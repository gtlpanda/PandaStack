{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "advisorModel": "fable",
  "effortLevel": "high",
  "permissions": {
    "defaultMode": "auto"
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "8",
    "CLAUDE_CODE_WORKFLOW_MAX_CONCURRENT_AGENTS": "8",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_SUBAGENT_MODEL_FORCE": "0",
    "CLAUDE_CODE_WORKFLOW_SUBAGENT_MODEL": "",
    "CLAUDE_CODE_SUBAGENT_EFFORT": "high"
  },
  "disableAllHooks": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills/bughunt/gate.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/bin/statusline.sh\""
  }
}
