{
  "backend": "claude",
  "branch": "autobuild/phase2",
  "featuresFile": "features.json",
  "progressFile": "PROGRESS.md",
  "maxConcurrentSubagents": 16,
  "codex": {
    "reasoningEffort": "high",
    "sessionTimeoutMinutes": 30
  },
  "bughunt": true,
  "bughuntBase": "0bc26048cbf99302a7f310689dad74da6388de11",
  "limits": {
    "maxIterations": 8,
    "noProgressLimit": 3,
    "reviewEvery": 4,
    "finalReview": true,
    "bughuntTimeoutMinutes": 120,
    "maxLimitWaitHours": 1,
    "probeEveryMinutes": 5
  },
  "runners": {
    "node": {
      "group": "node",
      "command": "node --test"
    }
  },
  "gate": [
    {
      "name": "baseline regression suite",
      "command": "bash scripts/test.sh"
    },
    {
      "name": "native hunt regressions",
      "command": "node --test graphs/hunt/test-native/*.test.mjs"
    },
    {
      "name": "Phase 1 acceptance",
      "command": "node --test acceptance/phase1/p1-*.test.mjs"
    },
    {
      "name": "Hunt evidence retention acceptance",
      "command": "node --test acceptance/harness/harness-repair.test.mjs"
    },
    {
      "name": "Hunt export and namespace acceptance",
      "command": "node --test acceptance/harness/export-namespace.test.mjs"
    },
    {
      "name": "Hunt capture descendant acceptance",
      "command": "node --test acceptance/harness/capture-descendant.test.mjs"
    },
    {
      "name": "Accepted Phase 2 regression acceptance",
      "command": "node --test acceptance/phase2/p2-01.test.mjs acceptance/phase2/p2-02.test.mjs acceptance/phase2/p2-03.test.mjs acceptance/phase2/p2-04.test.mjs acceptance/phase2/p2-05.test.mjs acceptance/phase2/p2-06.test.mjs acceptance/phase2/p2-07.test.mjs acceptance/phase2/p2-08.test.mjs acceptance/phase2/p2-09.test.mjs acceptance/phase2/p2-10.test.mjs acceptance/phase2/p2-11.test.mjs acceptance/phase2/p2-12.test.mjs acceptance/phase2/p2-13.test.mjs acceptance/phase2/p2-14.test.mjs acceptance/phase2/p2-15.test.mjs acceptance/phase2/p2-16.test.mjs"
    }
  ],
  "preflight": [
    {
      "name": "Node 24",
      "command": "node -e 'if(Number(process.versions.node.split(\".\")[0])<24)process.exit(1)'",
      "hint": "Use Node 24+"
    },
    {
      "name": "SQLite runtime",
      "command": "node --input-type=module -e 'import {DatabaseSync} from \"node:sqlite\"; const d=new DatabaseSync(\":memory:\"); d.close()'",
      "hint": "Use Node 24 with node:sqlite support"
    },
    {
      "name": "ShellCheck for CI verification",
      "command": "shellcheck --version",
      "hint": "Provide ShellCheck on PATH; CI lint remains mandatory."
    }
  ],
