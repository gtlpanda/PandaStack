{
  "backend": "codex",
  "branch": "codex/phase1-run-records",
  "featuresFile": "features.json",
  "progressFile": "PROGRESS.md",
  "model": "gpt-6-astra",
  "subagentModel": "gpt-6.1-sol",
  "probeModel": "gpt-6-luna",
  "maxConcurrentSubagents": 8,
  "codex": {
    "reasoningEffort": "medium",
    "sessionTimeoutMinutes": 30
  },
  "bughunt": true,
  "bughuntBase": "codex/phase1-baseline",
  "limits": {
    "maxIterations": 12,
    "noProgressLimit": 2,
    "reviewEvery": 4,
    "finalReview": true,
    "bughuntTimeoutMinutes": 120,
    "maxLimitWaitHours": 1,
    "probeEveryMinutes": 5
  },
  "runners": {
    "node": {
      "group": "node",
      "command": "node --test"
    }
  },
  "gate": [
    {
      "name": "baseline regression suite",
      "command": "bash scripts/test.sh"
    },
    {
      "name": "native hunt regressions",
      "command": "node --test graphs/hunt/test-native/*.test.mjs"
    }
  ],
  "preflight": [
    {
      "name": "Node 24",
      "command": "node -e 'if(Number(process.versions.node.split(\".\")[0])<24)process.exit(1)'",
      "hint": "Use Node 24+"
    }
  ],
  "frozen": [
    ".githooks",
    ".github",
